generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = env("DATABASE_PROVIDER")
  url      = env("DATABASE_URL")
}

enum InvoiceType {
  CASH
  CREDIT
}

enum InvoiceStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  VISA
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  fullName     String
  passwordHash String
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  userRoles    UserRole[]
  auditLogs    AuditLog[]
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]
  rolePerms   RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rolePerms   RolePermission[]
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model Customer {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  name          String
  phone         String?
  address       String?
  taxNumber     String?
  creditLimit   Decimal   @default(0)
  notes         String?
  currentBalance Decimal  @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  invoices      Invoice[]
  payments      Payment[]

  @@index([name])
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Unit {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id             Int       @id @default(autoincrement())
  sku            String    @unique
  barcode        String    @unique
  name           String
  sellingPrice   Decimal
  purchasePrice  Decimal
  quantityOnHand Decimal   @default(0)
  reorderLevel   Decimal   @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  categoryId     Int?
  unitId         Int?
  category       Category? @relation(fields: [categoryId], references: [id])
  unit           Unit?     @relation(fields: [unitId], references: [id])
  invoiceItems   InvoiceItem[]
  returnItems    ReturnItem[]
  stockTxns      StockTransaction[]

  @@index([sku])
}

model Invoice {
  id             Int           @id @default(autoincrement())
  number         String        @unique
  date           DateTime      @default(now())
  type           InvoiceType
  paymentMethod  PaymentMethod
  discountType   String?
  discountValue  Decimal       @default(0)
  vatRate        Decimal       @default(0)
  subtotal       Decimal
  total          Decimal
  status         InvoiceStatus @default(DRAFT)
  warehouse      String?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customerId     Int
  customer       Customer      @relation(fields: [customerId], references: [id])
  items          InvoiceItem[]
  returns        Return[]
  payments       PaymentInvoice[]

  @@index([number])
  @@index([customerId])
}

model InvoiceItem {
  id         Int      @id @default(autoincrement())
  quantity   Decimal
  price      Decimal
  discount   Decimal  @default(0)
  lineTotal  Decimal
  invoiceId  Int
  productId  Int
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@index([productId])
}

model Return {
  id               Int      @id @default(autoincrement())
  number           String   @unique
  date             DateTime @default(now())
  reason           String?
  status           InvoiceStatus @default(DRAFT)
  total            Decimal
  deletedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  invoiceId        Int
  invoice          Invoice  @relation(fields: [invoiceId], references: [id])
  items            ReturnItem[]
}

model ReturnItem {
  id         Int      @id @default(autoincrement())
  quantity   Decimal
  price      Decimal
  lineTotal  Decimal
  returnId   Int
  productId  Int
  return     Return   @relation(fields: [returnId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id           Int           @id @default(autoincrement())
  number       String        @unique
  date         DateTime      @default(now())
  amount       Decimal
  method       PaymentMethod
  notes        String?
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customerId   Int
  customer     Customer      @relation(fields: [customerId], references: [id])
  invoices     PaymentInvoice[]
}

model PaymentInvoice {
  paymentId Int
  invoiceId Int
  amount    Decimal
  payment   Payment @relation(fields: [paymentId], references: [id])
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  @@id([paymentId, invoiceId])
}

model StockTransaction {
  id          Int      @id @default(autoincrement())
  type        String
  quantity    Decimal
  reference   String
  productId   Int
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entity     String
  entityId   String
  payload    String?
  userId     Int?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
}

model Setting {
  id                   Int      @id @default(autoincrement())
  companyName          String   @default("STUDIO")
  companyAddress       String?
  companyLogo          String?
  vatEnabled           Boolean  @default(false)
  vatRate              Decimal  @default(0)
  invoicePrefix        String   @default("INV")
  allowNegativeStock   Boolean  @default(false)
  defaultCurrency      String   @default("EGP")
  updatedAt            DateTime @updatedAt
  createdAt            DateTime @default(now())
}

model NumberingSequence {
  id         Int      @id @default(autoincrement())
  key        String   @unique
  prefix     String
  current    Int      @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}
